{
  "manifest_version": 3,
  "name": "FocusInk — Website Highlighter",
  "version": "1.4.0",
  "minimum_chrome_version": "105",
  "description": "Highlight text, draw boxes, and keep notes on websites, even after a refresh.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "FocusInk",
    "default_popup": "popup.html",
    "default_icon": "icon-blue.png"
  },
  "icons": {
    "16": "icon-blue.png",
    "48": "icon-blue.png",
    "128": "icon-blue.png"
  },
  "background": { "service_worker": "background.js" },
  "options_page": "library.html",
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "css": ["content.css"],
    "js": ["anchor.js", "settings.js", "content.js"],
    "run_at": "document_idle"
  }]
}
